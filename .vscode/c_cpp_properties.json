{
  "version": 4,
  "configurations": [
    {
      "name": "xv6-riscv",
      "includePath": [
        "${workspaceFolder}",
        "${workspaceFolder}/kernel",
        "${workspaceFolder}/user",
        "${workspaceFolder}/mkfs"
      ],
      "defines": [
        "__riscv",
        "__riscv_xlen=64"
      ],
      "forcedInclude": [
        "${workspaceFolder}/.vscode/lab_intellisense_defines.h"
      ],
      "cStandard": "gnu11",
      "cppStandard": "gnu++17",
      "intelliSenseMode": "linux-gcc-riscv64",
      "compilerArgs": [
        "-ffreestanding",
        "-fno-builtin"
      ]
    }
  ]
}
